<Window x:Class="DWMB_AIO.DeviceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DWMB_AIO"
        mc:Ignorable="d"
        Title="DWMB - Select Network Adapter"
        Width="560" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="420" MinHeight="260">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="More than one network adapter was found. Select the one that carries your VATSIM connection (usually your main Wi-Fi or Ethernet adapter), then click OK."/>

        <ListBox Grid.Row="1"
                 x:Name="lstDevices"
                 DisplayMemberPath="Display"
                 SelectionMode="Single"
                 MouseDoubleClick="lstDevices_MouseDoubleClick"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnOk" Content="OK" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="btnOk_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="28" IsCancel="True" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

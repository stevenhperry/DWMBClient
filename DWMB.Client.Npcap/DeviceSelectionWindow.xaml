<Window x:Class="DWMB_AIO.DeviceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWMB - Select Capture Device" Width="500" Height="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Multiple network devices were found. Select the one used for your simulator/VATSIM connection:" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ListBox Name="lstDevices" Grid.Row="1" DisplayMemberPath="DisplayLabel"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="btnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

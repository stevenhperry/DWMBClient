<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>DWMB_AIO</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>DWMB32.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>DWMB_AIO.App</StartupObject>

    <!-- Add these to control versions produced by the build -->
    <Version>2.0.0.0</Version>                <!-- NuGet / package / product version -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion> <!-- runtime binding version -->
    <FileVersion>2.0.0.0</FileVersion>       <!-- file property shown in Explorer -->
    <InformationalVersion>2.0.0.0</InformationalVersion> <!-- product display (semver+metadata) -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DWMB AutoPilot Icon.png" />
    <None Remove="DWMB32.png" />
    <None Remove="kofi_qrcode.png" />
    <None Remove="dwmb.config.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="DWMB32.ico" />
    <!-- v1 used server_location.txt; v2 unifies config on the same
         dwmb.config.json mechanism (DWMB.Core.Config.DwmbConfig) the plugin
         adapters use, so all three adapters share one config convention. -->
    <Content Include="dwmb.config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DWMB.Core\DWMB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DWMB AutoPilot Icon.png" />
    <Resource Include="DWMB32.png" />
    <Resource Include="kofi_qrcode.png" />
  </ItemGroup>

</Project>

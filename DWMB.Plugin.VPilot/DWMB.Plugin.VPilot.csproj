<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- vPilot itself is a .NET Framework application; plugins run in its process
         and must target a compatible framework. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DWMB.Plugin.VPilot</RootNamespace>
    <AssemblyName>DWMB.Plugin.VPilot</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DWMB.Core\DWMB.Core.csproj" />
  </ItemGroup>

  <!-- vPilot has no NuGet-distributed plugin SDK -- real vPilot plugins (e.g.
       github.com/blt950/vPilot-Pushover) vendor a copy of
       RossCarlson.Vatsim.Vpilot.Plugins.dll (found in the vPilot install folder)
       directly into the plugin project. Drop that DLL (and its .xml doc, optional)
       into lib/ before building -- see lib/README.md. Private=false so it isn't
       copied into the plugin's output folder; vPilot already provides it at runtime. -->
  <ItemGroup>
    <Reference Include="RossCarlson.Vatsim.Vpilot.Plugins">
      <HintPath>lib\RossCarlson.Vatsim.Vpilot.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

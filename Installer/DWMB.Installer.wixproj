<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>DWMB-AIO-Client-Setup</OutputName>
    <Platform>x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

    <!-- Where the self-contained, published DWMB.exe (and friends) land before harvesting -->
    <AppPublishDir>$(MSBuildThisFileDirectory)bin\publish\win-x64\</AppPublishDir>

    <!-- Exposed to Package.wxs as $(var.RepoRoot) / $(var.AppPublishDir) -->
    <DefineConstants>RepoRoot=$(MSBuildThisFileDirectory)..\;AppPublishDir=$(AppPublishDir)</DefineConstants>

    <!--
      WiX Toolset v7 requires accepting the Open Source Maintenance Fee (OSMF) EULA
      before it will run (https://wixtoolset.org/osmf/) — WIX7015 otherwise. This is
      the "direct acceptance" form FireGiant documents for build scripts/CI: the SDK
      routes this property to wix.exe's -acceptEula switch itself, so it covers both
      `dotnet build` here and the identical command in .github/workflows/installer.yml,
      regardless of what (if any) global `wix` CLI tool version is on PATH.
    -->
    <AcceptEula>wix7</AcceptEula>

    <!--
      ICE38/ICE64 fire on every auto-harvested file component in the <Files> glob in
      Package.wxs (one component per published file), because per-user components
      (Scope="perUser", PerUserProgramFilesFolder) are required to be keyed on an HKCU
      registry value rather than a file, and per-user directories need explicit
      RemoveFile tracking. WiX's bulk <Files> harvesting has no option to generate
      either automatically — this is an acknowledged, currently-unresolved gap in the
      toolset itself (wixtoolset/issues#8633, "Generated components should be ICE-clean
      for per-user target directories"), not a mistake in this authoring. Hand-authoring
      a registry KeyPath per harvested file isn't practical for a 100+-file self-contained
      publish output, and DWMB installs/removes as one atomic unit with no per-file repair
      scenario these ICEs would actually protect against, so suppressing them here is the
      standard, documented workaround rather than a correctness compromise.
    -->
    <SuppressIces>ICE38;ICE64</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>

  <!--
    Publish the WPF app (self-contained win-x64) before WiX compiles Package.wxs. The <Files>
    glob in Package.wxs is expanded by the wix.exe compiler itself inside the CoreCompile
    target's WixBuild task call, so BeforeBuild (which always runs before CoreBuild/CoreCompile)
    is early enough and is the standard, stable MSBuild extension point for this.
  -->
  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\DWMB.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:DebugType=none -o &quot;$(AppPublishDir)&quot;" />
  </Target>

</Project>
